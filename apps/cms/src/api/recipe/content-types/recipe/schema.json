{
  "kind": "collectionType",
  "collectionName": "recipes",
  "info": {
    "singularName": "recipe",
    "pluralName": "recipes",
    "displayName": "Recipe",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "ingredients": {
      "type": "component",
      "repeatable": true,
      "component": "shared.ingredient"
    },
    "steps": {
      "type": "richtext",
      "required": true
    },
    "prepTime": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "cookTime": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "servings": {
      "type": "integer",
      "required": true,
      "min": 1
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard"],
      "default": "easy",
      "required": true
    }
  }
}
